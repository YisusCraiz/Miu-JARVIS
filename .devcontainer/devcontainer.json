{
  "name": "Miu Python core",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash scripts/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Miu API", "onAutoForward": "notify", "visibility": "private"}},
  "customizations": {"vscode": {"settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}}}
}
